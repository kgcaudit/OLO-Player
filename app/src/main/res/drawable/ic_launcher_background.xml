<?xml version="1.0" encoding="utf-8"?>
<!-- OLO 계열 공통 실행 아이콘 바탕: 왼쪽 위가 밝은 315° 그라데이션.
     OLO Explorer/eBook 과 같은 값이라 홈 화면에서 한 식구로 보인다. -->
